# Production environment template for deploy/compose.production.yml.
# Copy to deploy/.env.production.local and replace every placeholder.
# Keep the real file private (mode 600). Never commit or paste real values.

NODE_ENV=production
PORT=4000
ENABLE_BACKGROUND_SCHEDULERS=true

# Compose database variables. Use a unique, strong password.
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=laundryangel

# Compose constructs DATABASE_URL from POSTGRES_*; do not put it in the web build.
# Set these to the actual public origins after the domain is available.
APP_URL=https://api.example.com
WEB_APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# Use distinct, randomly generated production secrets (at least 16 characters).
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Protect uploaded migration files with a unique key of at least 16 characters.
MIGRATION_STORAGE_KEY=REPLACE_WITH_LONG_RANDOM_MIGRATION_STORAGE_KEY
# Compose sets MIGRATION_STORAGE_DIR to the persistent container volume.

# Optional subscription payments. Keep the secret server-side only.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Optional customer receipt delivery integrations.
RESEND_API_KEY=
RECEIPT_EMAIL_FROM=receipts@example.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=

LOG_LEVEL=info
