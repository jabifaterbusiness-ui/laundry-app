# Production environment template for deploy/compose.production.yml.
# Copy to deploy/.env.production.local and replace every placeholder.
# Never commit real values or paste this file into chat.

NODE_ENV=production
PORT=4000
ENABLE_BACKGROUND_SCHEDULERS=true

# Compose database variables. Use a strong unique password.
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=laundryangel

# Application URLs. APP_URL is also used to construct OAuth callback URLs.
APP_URL=https://api.example.com
WEB_APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# Use different long random values. Never reuse development secrets.
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Migration file protection. Set a unique value of at least 16 characters.
MIGRATION_STORAGE_KEY=REPLACE_WITH_LONG_RANDOM_MIGRATION_STORAGE_KEY
MIGRATION_STORAGE_DIR=./data/migrations

# Automatic cloud-backup encryption.
# Generate exactly 64 hexadecimal characters (32 random bytes).
# CRITICAL: keep this value stable; rotating it can make previously encrypted
# cloud-provider credentials and backup artifacts unreadable.
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTER_BACKUP_ENCRYPTION_KEY

# Google Drive OAuth (required when Google Drive backups are used).
# Register APP_URL/api/v1/migrations/backup/cloud/oauth/callback as redirect URI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Dropbox OAuth (required when Dropbox backups are used).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Microsoft OneDrive OAuth (required when OneDrive backups are used).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Paystack subscriptions (required when Paystack subscription payments are used).
# Use the server-side secret key; never put it in the frontend.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Optional receipt delivery integrations.
RESEND_API_KEY=
RECEIPT_EMAIL_FROM=receipts@example.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=

LOG_LEVEL=info
