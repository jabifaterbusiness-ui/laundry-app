# Production API environment template.
# Copy into your hosting provider's secret/environment settings.
# Never commit real values.

NODE_ENV=production
PORT=4000

APP_URL=https://api.example.com
WEB_APP_URL=https://app.example.com

DATABASE_URL=postgresql://PRODUCTION_DB_USER:PRODUCTION_DB_PASSWORD@PRODUCTION_DB_HOST:5432/PRODUCTION_DB_NAME?schema=public

JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_PRODUCTION_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PRODUCTION_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://app.example.com

RESEND_API_KEY=REPLACE_WITH_PRODUCTION_RESEND_API_KEY
RESEND_FROM_EMAIL=receipts@example.com

WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PRODUCTION_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=v23.0

LOG_LEVEL=info
MIGRATION_STORAGE=prisma
