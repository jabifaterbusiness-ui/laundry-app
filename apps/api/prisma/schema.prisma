  // Non-secret provider capabilities/configuration.
  supportedCountries  Json
  supportedCurrencies Json
  supportedMethods    Json

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformConfigId, providerKey])
  @@index([enabled, displayOrder])
  @@map("payment_provider_configs")
}

model PaymentMethodConfig {
  id String @id @default(uuid())

  platformConfigId String
  platformConfig   PlatformConfig @relation(fields: [platformConfigId], references: [id], onDelete: Cascade)

  // Stable configurable key, e.g. card, bank_transfer, ussd, opay.
  methodKey   String
  displayName String

  // Optional provider restriction. Null means the method may be available
  // through any compatible enabled provider.
  providerKey String?

  enabled Boolean @default(false)

  supportedCountries  Json
  supportedCurrencies Json

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformConfigId, methodKey])
  @@index([enabled, displayOrder])
  @@index([providerKey, enabled])
  @@map("payment_method_configs")
}

model SubscriptionPaymentIntent {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan         SubscriptionPlan
  amount       Int
  currencyCode String

  // Stable reference exposed to providers/customers where applicable.
  paymentReference String @unique

  // Client-generated idempotency key for safe online/offline retries.
  idempotencyKey String @unique

  origin PaymentIntentOrigin
  status SubscriptionPaymentStatus @default(CREATED)

  providerKey      String?
  paymentMethodKey String?

  providerCheckoutReference String?
  providerCheckoutUrl       String?
  expiresAt                 DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment SubscriptionPayment?

  @@index([businessId, status, createdAt])
  @@index([businessId, plan, createdAt])
  @@map("subscription_payment_intents")
}

model SubscriptionPayment {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  intentId String                    @unique
  intent   SubscriptionPaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  // Permanent LaundryAngel payment reference.
  paymentReference String @unique

