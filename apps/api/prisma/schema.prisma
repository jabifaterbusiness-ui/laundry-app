  plan         SubscriptionPlan
  countryCode  String
  currencyCode String
  amount       Int

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plan, countryCode, currencyCode])
  @@index([countryCode, currencyCode, isActive])
