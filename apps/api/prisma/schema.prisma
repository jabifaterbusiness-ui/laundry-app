// ---------------------------------------------------------------------
// SUBSCRIPTION BILLING FOUNDATION
// ---------------------------------------------------------------------
// Subscription entitlement remains separate from payment accounting.
// These models track payment identity, pricing, payment intents,
// verified subscription payments, and provider webhook idempotency.
//
// SECURITY RULE:
// A locally recorded/offline payment intent NEVER grants subscription
// access. Entitlement changes occur only after authoritative payment
// verification or an explicitly audited Platform Owner recovery action.
// ---------------------------------------------------------------------

enum SubscriptionPaymentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  EXPIRED
  REQUIRES_VERIFICATION
}

enum PaymentIntentOrigin {
  ONLINE
  OFFLINE
  PLATFORM_OWNER
}

model BusinessPaymentIdentity {
  id String @id @default(uuid())

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Permanent LaundryAngel business identity. It must never be derived
  // from the company name and must never be recycled to another business.
  businessCode String @unique
  // Permanent payment reference linked to this business.
  paymentCode  String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_payment_identities")
}

model SubscriptionPlanPrice {
