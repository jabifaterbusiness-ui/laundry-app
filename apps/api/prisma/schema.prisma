  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  providerKey     String
  providerEventId String

  eventType   String
  processed   Boolean   @default(false)
  processedAt DateTime?

  // Provider payload may be retained for reconciliation, but secrets
  // must never be stored here.
  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerKey, providerEventId])
  @@index([businessId, createdAt])
  @@index([providerKey, processed, createdAt])
  @@map("payment_webhook_events")
}

// ---------------------------------------------------------------------
// MONTHLY FINANCIAL STATEMENT DELIVERY
// ---------------------------------------------------------------------
//
// A business has one monthly statement configuration. Recipients are
// explicitly configured rather than inferred only from job title.
//
// The statement itself is business-wide and therefore aggregates all
// branches belonging to the business.
//
// Delivery records are idempotent per statement/channel/recipient so
// repeated scheduler execution cannot intentionally create duplicate
// deliveries.
//
model FinancialStatementConfig {
  id String @id @default(uuid())

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  // Default locked schedule: first day of every month.
  dayOfMonth Int @default(1)
  hour       Int @default(8)
  minute     Int @default(0)

  emailEnabled    Boolean @default(true)
  whatsappEnabled Boolean @default(false)

  // Independent daily report schedule. Monthly settings above remain unchanged.
  dailyEnabled         Boolean @default(false)
  dailyHour            Int     @default(8)
  dailyMinute          Int     @default(0)
  dailyEmailEnabled    Boolean @default(true)
  dailyWhatsappEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("financial_statement_configs")
}

model FinancialStatementRecipient {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("FinancialStatementRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  // Explicit WhatsApp destination. Email uses the User.email address.
  whatsappNumber String?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries FinancialStatementDelivery[]

  @@unique([businessId, userId])
  @@index([businessId, enabled])
  @@index([userId])
  @@map("financial_statement_recipients")
}

model FinancialStatement {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  currencyCode String

  grossRevenue     Int
  refundAmount     Int
  netRevenue       Int
  explicitExpenses Int
  salaryExpense    Int
  totalExpenses    Int
  profitOrLoss     Int

  generatedAt DateTime @default(now())

  deliveries FinancialStatementDelivery[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([businessId, periodStart, periodEnd])
  @@map("financial_statements")
}

model FinancialStatementDelivery {
  id String @id @default(uuid())

  statementId String
  statement   FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   FinancialStatementRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  channel FinancialStatementChannel
  status  FinancialStatementDeliveryStatus @default(PENDING)

  destination       String
  providerMessageId String?

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([statementId, recipientId, channel])
  @@index([statementId, status])
  @@index([recipientId, status])
  @@map("financial_statement_deliveries")
}


enum BackupScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum BackupCloudProvider {
  GOOGLE_DRIVE
  DROPBOX
  ONEDRIVE
  S3_COMPATIBLE
}

enum BackupConnectionStatus {
  PENDING
  CONNECTED
  ERROR
}

enum BackupRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum BackupRunTrigger {
  MANUAL
  SCHEDULED
}

model BackupSettings {
  id                     String                 @id @default(uuid())
  businessId             String                 @unique
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled                Boolean                @default(false)
  frequency              BackupScheduleFrequency @default(DAILY)
  dayOfWeek              Int                    @default(1)
  dayOfMonth             Int                    @default(1)
  hour                   Int                    @default(2)
  minute                 Int                    @default(0)
  timezone               String                 @default("Africa/Lagos")
  retentionCount         Int                    @default(30)
  destinationConnectionId String?
  destinationConnection  BackupCloudConnection? @relation("BackupDestination", fields: [businessId, destinationConnectionId], references: [businessId, id], onDelete: Restrict)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([enabled, frequency, hour, minute])
  @@map("backup_settings")
}

model BackupCloudOAuthState {
  id                  String              @id @default(uuid())
  businessId          String
  userId              String
  provider            BackupCloudProvider
  displayName         String
  stateHash           String              @unique
  verifierCiphertext  String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime            @default(now())

  @@index([expiresAt])
  @@index([businessId, createdAt])
  @@map("backup_cloud_oauth_states")
}

model BackupCloudConnection {
  id             String                @id @default(uuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider       BackupCloudProvider
  displayName    String
  config         Json?
  credentialsCiphertext String
  status         BackupConnectionStatus @default(PENDING)
  verifiedAt     DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  selectedBySettings BackupSettings[]   @relation("BackupDestination")
  selectedBySchedules BackupSchedule[] @relation("BackupScheduleDestination")
  runs           BackupRun[]

  @@unique([businessId, id])
  @@index([businessId, provider])
  @@index([businessId, status])
  @@map("backup_cloud_connections")
}

model BackupSchedule {
  id                      String                  @id @default(uuid())
  businessId              String
  business                Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                    String                  @default("Backup schedule")
  enabled                 Boolean                 @default(false)
  frequency               BackupScheduleFrequency @default(DAILY)
  dayOfWeek               Int                     @default(1)
  dayOfMonth              Int                     @default(1)
  hour                    Int                     @default(2)
  minute                  Int                     @default(0)
  clockFormat             String                  @default("12H")
  timezone                String                  @default("Africa/Lagos")
  retentionCount          Int                     @default(30)
  destinationConnectionId String?
  destinationConnection   BackupCloudConnection?  @relation("BackupScheduleDestination", fields: [businessId, destinationConnectionId], references: [businessId, id], onDelete: Restrict)
  runs                    BackupRun[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([businessId, id])
  @@index([businessId, enabled, frequency, hour, minute])
  @@index([businessId, destinationConnectionId])
  @@map("backup_schedules")
}

model BackupRun {
  id           String          @id @default(uuid())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scheduleId   String?
  schedule     BackupSchedule? @relation(fields: [businessId, scheduleId], references: [businessId, id], onDelete: Restrict)
  connectionId String?
  connection   BackupCloudConnection? @relation(fields: [businessId, connectionId], references: [businessId, id], onDelete: Restrict)
  trigger      BackupRunTrigger
  status       BackupRunStatus @default(PENDING)
  storageKey   String?
  checksumSha256 String?
  sizeBytes    BigInt?
  startedAt    DateTime        @default(now())
  scheduledFor DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([scheduleId, scheduledFor])
  @@index([businessId, scheduleId, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([connectionId, status])
  @@map("backup_runs")
}


model BusinessInboxMessage {
  id                       String   @id @default(uuid())
  broadcastId              String
  businessId               String
  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User     @relation("BusinessInboxRecipient", fields: [userId], references: [id], onDelete: Cascade)
  title                    String
  body                     String   @db.Text
  displayDurationMinutes   Int      @default(10)
  publishedAt              DateTime @default(now())
  expiresAt                DateTime?
  readAt                   DateTime?
  dismissedAt              DateTime?
  notificationKey          String?  @unique
  sourceSubscriptionId     String?
  createdByPlatformAdminId String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  @@index([businessId, userId, publishedAt])
  @@index([userId, readAt, publishedAt])
  @@index([broadcastId])
  @@index([sourceSubscriptionId, readAt])
  @@map("business_inbox_messages")
}


// ---------------------------------------------------------------------
// PRICE ADJUSTMENTS, TAX CONFIGURATION AND CUSTOMER PRICE OVERRIDES
// ---------------------------------------------------------------------

model PriceAdjustment {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  percentage Float
  isActive   Boolean  @default(true)

  // MANUAL adjustments remain selectable by staff. Automatic discounts can
  // target one customer, a customer group, or every customer in the business.
  targetScope String @default("MANUAL")
  customerId  String?
  customer    Customer? @relation("CustomerAutomaticDiscounts", fields: [customerId], references: [id], onDelete: Cascade)
  groupId     String?
  group       CustomerGroup? @relation("CustomerGroupAutomaticDiscounts", fields: [groupId], references: [id], onDelete: Cascade)
  startsAt    DateTime?
  endsAt      DateTime?
  allowStacking Boolean @default(false)
  excludedServiceIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, targetScope, startsAt, endsAt])
  @@index([businessId, customerId])
  @@index([businessId, groupId])
  @@map("price_adjustments")
}

model TaxRule {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  kind               String   // PERCENTAGE or FIXED
  value              Float
  treatment          String   // ADDITIVE or WITHHOLDING
  enabledByDefault   Boolean  @default(false)
  allowWithOtherTaxes Boolean @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, isActive, enabledByDefault])
  @@map("tax_rules")
}

model CustomerServicePrice {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  serviceId  String
  unitPrice  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceId])
  @@index([businessId, customerId])
  @@index([businessId, serviceId])
  @@map("customer_service_prices")
}


// ---------------------------------------------------------------------
// CUSTOMER GROUPS FOR TARGETED COMMUNICATIONS
// ---------------------------------------------------------------------

model CustomerGroup {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     CustomerGroupMember[]
  automaticDiscounts PriceAdjustment[] @relation("CustomerGroupAutomaticDiscounts")

  @@unique([businessId, name])
  @@index([businessId, createdAt])
  @@map("customer_groups")
}

model CustomerGroupMember {
  id         String        @id @default(uuid())
  businessId String
  groupId    String
  customerId String
  createdAt  DateTime      @default(now())
  group      CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([groupId, customerId])
  @@index([businessId, groupId])
  @@index([businessId, customerId])
  @@map("customer_group_members")
}

// ---------------------------------------------------------------------
// CUSTOMER ANNOUNCEMENTS, ORDER STATUS NOTIFICATIONS AND REMINDERS
// ---------------------------------------------------------------------

model AnnouncementCampaign {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  message         String
  channels        String[] @default([])
  audience        String   // ALL_CUSTOMERS or SELECTED_CUSTOMERS
  status          String   @default("DRAFT")
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipients AnnouncementRecipient[]
  deliveries CommunicationDelivery[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@map("announcement_campaigns")
}

model AnnouncementRecipient {
  id         String   @id @default(uuid())
  campaignId String
  customerId String
  createdAt  DateTime @default(now())
  campaign   AnnouncementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([customerId])
  @@map("announcement_recipients")
}

model CommunicationDelivery {
  id                String   @id @default(uuid())
  businessId        String
  customerId        String
  orderId           String?
  campaignId        String?
  channel           String
  messageType       String
  destination       String
  status            String   @default("PENDING")
  providerMessageId String?
  errorMessage      String?
  dedupeKey         String   @unique
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  campaign          AnnouncementCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId, messageType])
  @@index([campaignId, channel, status])
  @@map("communication_deliveries")
}

model OrderStatusNotificationRule {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status             String
  enabled            Boolean  @default(true)
  channel            String   @default("WHATSAPP")
  whatsappMessage    String?
  whatsappTemplateName String?
  whatsappTemplateLanguage String?
  emailSubject       String?
  emailMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deliveries OrderStatusNotificationDelivery[]

  @@unique([businessId, status])
  @@index([businessId, enabled])
  @@map("order_status_notification_rules")
}

model OrderStatusNotificationDelivery {
  id                String   @id @default(uuid())
  businessId        String
  orderId           String
  ruleId            String
  customerId        String
  status            String
  channel           String
  destination       String
  deliveryStatus    String   @default("PENDING")
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rule              OrderStatusNotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([orderId, ruleId, status])
  @@index([businessId, deliveryStatus, createdAt])
  @@index([customerId, createdAt])
  @@map("order_status_notification_deliveries")
}


model WhatsAppBusinessConnection {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  wabaId                String
  phoneNumberId         String   @unique
  displayPhoneNumber    String?
  verifiedName          String?
  encryptedAccessToken  String   @db.Text
  tokenExpiresAt        DateTime?
  status                String   @default("CONNECTED")
  connectedAt           DateTime @default(now())
  lastVerifiedAt        DateTime?
  lastError             String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  webhookEvents WhatsAppWebhookEvent[]

  @@index([wabaId])
  @@index([status, updatedAt])
  @@map("whatsapp_business_connections")
}

model WhatsAppWebhookEvent {
  id                 String   @id @default(uuid())
  businessId         String?
  business           Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  connectionId       String?
  connection         WhatsAppBusinessConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  eventKey           String   @unique
  wabaId             String?
  phoneNumberId      String?
  providerMessageId  String?
  contactPhone       String?
  eventType          String
  payload            Json
  processedAt        DateTime?
  processingError    String?  @db.Text
  receivedAt         DateTime @default(now())

  @@index([businessId, receivedAt])
  @@index([connectionId, receivedAt])
  @@index([providerMessageId])
  @@index([businessId, contactPhone, eventType, receivedAt], map: "wa_events_business_contact_type_received_idx")
  @@index([processedAt, receivedAt])
  @@map("whatsapp_webhook_events")
}

model UnpickedOrderReminderConfig {
  id             String   @id @default(uuid())
  businessId     String   @unique
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(true)
  thresholdMonths Int     @default(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("unpicked_order_reminder_configs")
}
