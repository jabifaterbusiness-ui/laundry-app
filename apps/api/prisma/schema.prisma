  providerTransactionId String?

  providerKey      String
  paymentMethodKey String

  amount       Int
  currencyCode String
  status       SubscriptionPaymentStatus

  receivedAt DateTime?
  verifiedAt DateTime?

  // Prevents duplicate business processing even if a provider retries.
  idempotencyKey String @unique

  metadata Json?

  // Subscription payment confirmation email delivery state.
  confirmationEmailSentAt            DateTime?
  confirmationEmailProviderMessageId String?
  confirmationEmailLastError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerKey, providerTransactionId])
  @@index([businessId, status, createdAt])
  @@index([businessId, paymentReference])
  @@index([providerKey, status, createdAt])
  @@map("subscription_payments")
}

model PaymentWebhookEvent {
