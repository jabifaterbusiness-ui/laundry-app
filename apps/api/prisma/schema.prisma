// ---------------------------------------------------------------------
// OFFLINE SYNC FOUNDATION
// ---------------------------------------------------------------------
// Durable record of a client-originated operation that may need to be
// reconciled after temporary offline operation.
//
// SECURITY RULES:
// - businessId and branchId are always derived/validated server-side.
// - clientOperationId is an idempotency key and prevents duplicate
//   application of the same client operation within a business.
// - payload is treated as untrusted input and must never be replayed as
//   an arbitrary HTTP request.
// - authorization is re-evaluated when an operation is processed.
// - financial, security-sensitive, and other unsafe operations must not
//   be added to the offline-safe command allowlist without explicit
//   conflict/replay rules.
// ---------------------------------------------------------------------

enum OfflineSyncStatus {
  PENDING
  PROCESSING
  APPLIED
  CONFLICT
  REJECTED
  FAILED
}

enum OfflineSyncOperationType {
  ORDER_CREATE
  ORDER_UPDATE
  CUSTOMER_CREATE
  CUSTOMER_UPDATE
}

model OfflineSyncOperation {
  id String @id @default(uuid())

  // Tenant and operational scope.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Authenticated user who originated the operation.
  actorUserId String
  actor       User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  // Stable client-generated idempotency key.
  clientOperationId String

  operationType OfflineSyncOperationType
  status        OfflineSyncStatus        @default(PENDING)

  // Version/shape marker for future payload migrations.
  payloadVersion Int @default(1)

  // Domain-command payload. Never treated as an arbitrary HTTP request.
  payload Json

  attemptCount Int @default(0)

  lastAttemptAt DateTime?
  processedAt   DateTime?

  // Set when the operation cannot safely be applied automatically.
  conflictReason String?

  // Safe diagnostic information for retry/reconciliation.
  lastError String?

  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, clientOperationId])
  @@index([businessId, branchId, status, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, actorUserId, createdAt])
  @@index([correlationId])
  @@map("offline_sync_operations")
}

