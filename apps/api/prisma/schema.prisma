// Prisma schema - FOUNDATION PHASE
//
// This schema defines PLATFORM/IDENTITY + AUDIT INFRASTRUCTURE models only:
//   - Business (tenant), Branch, User, UserBranch, RefreshToken, AuditLog, Role
// These are foundation because every future business-domain model
// (Customer, Order, Invoice, Payment, InventoryItem, etc.) must be scoped
// to a Business (and usually a Branch), so the isolation boundary and the
// audit trail have to exist before those modules are built.
//
// Operational/business-domain models are intentionally NOT defined yet -
// they belong to their respective module implementation phases (see
// docs/ARCHITECTURE.md for the full list and implementation order).
//
// ---------------------------------------------------------------------
// LOCKED ARCHITECTURAL DECISIONS (approved - see docs/ARCHITECTURE.md)
// ---------------------------------------------------------------------
// 1. TENANT ISOLATION: one shared PostgreSQL database, row-level tenant
//    isolation. Every tenant-scoped table carries a businessId column.
//    Database-per-tenant and schema-per-tenant are explicitly rejected.
//    Tenant context is always derived server-side from the authenticated
//    user - a client-supplied businessId is never trusted for
//    authorization (see src/lib/tenant-scope.ts).
// 2. AUDIT TRAIL: generic AuditLog is foundation infrastructure (below),
//    not a future module. Business modules call into it; they don't
//    reimplement it.
// 3. USER <-> BRANCH: many-to-many via UserBranch. A user's business
//    membership, branch memberships, and currently-selected/active
//    branch (a request-scoped, server-validated concept - see
//    src/middleware/branch-context.ts) are three distinct things and
//    must not be conflated.
// 4. ROLES: fixed enum for v1 (PLATFORM_ADMIN, BUSINESS_OWNER,
//    BRANCH_MANAGER, STAFF). A permission-table model may replace this
//    later; the authorization code is written so that swap is isolated.
// ---------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// LOCKED for v1 - see decision #4 above. Not dynamic/custom per business.
enum Role {
  PLATFORM_ADMIN
  BUSINESS_OWNER
  BRANCH_MANAGER
  STAFF
}

enum SubscriptionPlan {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// A tenant. Every business-scoped record in the system will eventually
// carry a businessId pointing here.
model Business {
  id   String @id @default(uuid())
  name String
  slug String @unique

  // Customer-facing company contact information used on receipts.
  phone   String?
  email   String?
  website String?
  address String?

  // -------------------------------------------------------------------
  // ORGANISATION MARKET SETTINGS
  // -------------------------------------------------------------------
  // Nigeria is the default v1 market. Each organisation can configure
  // its own country, currency, timezone, and locale.
  countryCode  String @default("NG")
  currencyCode String @default("NGN")
  timezone     String @default("Africa/Lagos")
  locale       String @default("en-NG")

  // -------------------------------------------------------------------
  // RECEIPT BRANDING
  // -------------------------------------------------------------------
  // The logo is stored outside PostgreSQL; this field stores its
  // publicly usable application URL/reference.
  logoUrl String?

  // Automatically generated from the business logo by default.
  // The owner may override these values through receipt customization.
  receiptPrimaryColor    String?
  receiptAccentColor     String?
  receiptBackgroundColor String?
  receiptTextColor       String?

  // Controls the visual arrangement of the digital receipt header.
  // Kept as a string initially so the branding system can evolve
  // without unnecessary enum migrations.
  receiptHeaderStyle String?

  // Default customer agreement used when invoices are generated
  // automatically from newly created orders. Each invoice stores its
  // own historical snapshot, so later changes do not affect old invoices.
  defaultCustomerAgreement String @default("Customer agrees to the laundry service terms and conditions.")

  colors Color[]

  // -------------------------------------------------------------------
  // SUBSCRIPTION
  // -------------------------------------------------------------------
  subscription            Subscription?
  paymentIdentity         BusinessPaymentIdentity?
  sensitiveAuthorizations SensitiveAuthorization[]

  isActive         Boolean   @default(true)
  suspendedUntil   DateTime?
  suspensionReason String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt DateTime @updatedAt

  branches                    Branch[]
  users                       User[]
  auditLogs                   AuditLog[]
  customers                   Customer[]                   @relation("BusinessCustomers")
  customerStatusHistory       CustomerStatusHistory[]      @relation("BusinessCustomerStatusHistory")
  customerAccounts            CustomerAccount[]
  customerAccountTransactions CustomerAccountTransaction[]
  services                    Service[]
  priceAdjustments            PriceAdjustment[]
  taxRules                     TaxRule[]
  announcementCampaigns       AnnouncementCampaign[]
  communicationDeliveries     CommunicationDelivery[]
  orderStatusNotificationRules OrderStatusNotificationRule[]
  orderStatusNotificationDeliveries OrderStatusNotificationDelivery[]
  unpickedOrderReminderConfig  UnpickedOrderReminderConfig?
  customerGroups               CustomerGroup[]
  orders                      Order[]
  invoices                    Invoice[]
  payments                    Payment[]
  payrollPayments             PayrollPayment[]
  orderNumberSequence         OrderNumberSequence?
  migrationJobs               MigrationJob[]
  garments                    Garment[]

  payrollPeriods               PayrollPeriod[]
  payrollRecords               PayrollRecord[]
  ious                         IOU[]
  loans                        Loan[]
  payrollDeductions            PayrollDeduction[]
  employeeCompensations        EmployeeCompensation[]
  financialRepayments          FinancialRepayment[]
  expenses                     Expense[]
  financialStatementConfig     FinancialStatementConfig?
  financialStatementRecipients FinancialStatementRecipient[]
  financialStatements          FinancialStatement[]
  inventoryItems               InventoryItem[]
  inventorySuppliers            InventorySupplier[]
  inventoryPurchaseOrders       InventoryPurchaseOrder[]
  inventoryGoodsReceipts        InventoryGoodsReceipt[]
  inventoryStocks              InventoryStock[]
  inventoryMovements           InventoryMovement[]
  inventoryTransfers           InventoryTransfer[]
  inventoryStocktakes          InventoryStocktake[]
  inventoryReservations        InventoryReservation[]
  businessRolePermissions      BusinessRolePermission[]
  userPermissionOverrides      UserPermissionOverride[]
  offlineSyncOperations        OfflineSyncOperation[]
  subscriptionPaymentIntents   SubscriptionPaymentIntent[]
  subscriptionPayments         SubscriptionPayment[]
  paymentWebhookEvents         PaymentWebhookEvent[]
  backupSettings               BackupSettings?
  whatsappConnection           WhatsAppBusinessConnection?
  whatsappWebhookEvents        WhatsAppWebhookEvent[]
  backupSchedules              BackupSchedule[]
  backupConnections            BackupCloudConnection[]
  backupRuns                   BackupRun[]
  inboxMessages                BusinessInboxMessage[]

  @@map("businesses")
}

// A physical/operational location within a business.
// User <-> Branch is many-to-many (LOCKED decision #3) via UserBranch.
model Branch {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userBranches                UserBranch[]
  auditLogs                   AuditLog[]
  orders                      Order[]
  invoices                    Invoice[]
  payments                    Payment[]
  customerAccountTransactions CustomerAccountTransaction[]
  garments                    Garment[]

  payrollPeriods        PayrollPeriod[]
  payrollRecords        PayrollRecord[]
  payrollPayments       PayrollPayment[]
  ious                  IOU[]
  loans                 Loan[]
  payrollDeductions     PayrollDeduction[]
  financialRepayments   FinancialRepayment[]
  expenses              Expense[]
  inventoryStocks       InventoryStock[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryGoodsReceipts InventoryGoodsReceipt[]
  inventoryMovements    InventoryMovement[]
  inventoryTransfersFrom InventoryTransfer[] @relation("InventoryTransferSource")
  inventoryTransfersTo   InventoryTransfer[] @relation("InventoryTransferDestination")
  inventoryStocktakes    InventoryStocktake[]
  inventoryReservations  InventoryReservation[]
  offlineSyncOperations OfflineSyncOperation[]

  @@index([businessId])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  fullName     String
  // Visible business job title chosen by management.
  // This is descriptive only and never grants access.
  role         String    @default("Staff")
  // Internal security foundation used only for protected system behavior.
  securityRole Role      @default(STAFF)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  // Nullable because PLATFORM_ADMIN is not tied to a single business.
  // Every BUSINESS_OWNER / BRANCH_MANAGER / STAFF user MUST have a
  // businessId - enforced in application logic (not expressible as a
  // conditional-required FK in Prisma/Postgres without a check
  // constraint, which can be added in a follow-up migration).
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Branch membership is many-to-many (LOCKED decision #3). There is
  // deliberately no single branchId column on User anymore - see
  // UserBranch below, and src/middleware/branch-context.ts for how the
  // *currently selected* branch is derived per-request and validated
  // against this table (never trusted from a client-supplied value or
  // baked into a long-lived token).
  branches UserBranch[]

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  sensitiveAuthorizations SensitiveAuthorization[]
  auditLogs               AuditLog[]
  migrationJobs           MigrationJob[]

  payrollRecords        PayrollRecord[]
  payrollPayments       PayrollPayment[]
  ious                  IOU[]
  loans                 Loan[]
  employeeCompensations EmployeeCompensation[]

  approvedIOUs  IOU[]  @relation("IOUApprover")
  approvedLoans Loan[] @relation("LoanApprover")

  financialRepaymentsAsEmployee FinancialRepayment[]          @relation("FinancialRepaymentEmployee")
  financialRepaymentsCreated    FinancialRepayment[]          @relation("FinancialRepaymentCreator")
  expensesCreated               Expense[]                     @relation("ExpenseCreator")
  expensesApproved              Expense[]                     @relation("ExpenseApprover")
  expensesRecognized            Expense[]                     @relation("ExpenseRecognizer")
  financialStatementRecipients  FinancialStatementRecipient[] @relation("FinancialStatementRecipientUser")
  inventoryMovementsCreated     InventoryMovement[]           @relation("InventoryMovementCreator")
  inventoryTransfersCreated     InventoryTransfer[]            @relation("InventoryTransferCreator")
  inventoryTransfersDispatched  InventoryTransfer[]            @relation("InventoryTransferDispatcher")
  inventoryTransfersReceived    InventoryTransfer[]            @relation("InventoryTransferReceiver")
  inventoryStocktakesCreated    InventoryStocktake[]             @relation("InventoryStocktakeCreator")
  inventoryStocktakesSubmitted  InventoryStocktake[]             @relation("InventoryStocktakeSubmitter")
  inventoryStocktakesApproved   InventoryStocktake[]             @relation("InventoryStocktakeApprover")
  inventoryStocktakesApplied    InventoryStocktake[]             @relation("InventoryStocktakeApplier")
  inventoryReservationsCreated  InventoryReservation[]           @relation("InventoryReservationCreator")
  inventoryPurchaseOrdersCreated InventoryPurchaseOrder[]      @relation("InventoryPurchaseOrderCreator")
  inventoryGoodsReceiptsReceived InventoryGoodsReceipt[]       @relation("InventoryGoodsReceiptReceiver")
  inboxMessages                BusinessInboxMessage[]          @relation("BusinessInboxRecipient")

  customersStatusChanged       Customer[]              @relation("CustomerStatusChangedBy")
  customerStatusHistoryChanges CustomerStatusHistory[] @relation("CustomerStatusHistoryChangedBy")

  permissionOverrides UserPermissionOverride[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  OfflineSyncOperation OfflineSyncOperation[]

  @@index([businessId])
  @@index([businessId, deletedAt])
  @@map("users")
}

// Join table for the many-to-many User <-> Branch relationship
// (LOCKED decision #3). A row here grants a user access to a branch;
// it does NOT by itself mean that branch is "active" for any given
// request - that's request-scoped context, not stored state.
model SensitiveAuthorization {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([businessId, expiresAt])
  @@map("sensitive_authorizations")
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}

// Business subscription lifecycle.
// Subscription state belongs to the tenant, not an individual user.
// Expiry is evaluated from endsAt at request time rather than embedded
// in access tokens, so access can be blocked immediately when a plan ends.
model Subscription {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan     SubscriptionPlan
  status   SubscriptionStatus @default(ACTIVE)
  startsAt DateTime
  endsAt   DateTime
  cancelAtPeriodEnd Boolean @default(false)
  cancelledAt DateTime?
  cancellationReason String?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  SubscriptionPayment SubscriptionPayment[]

  @@index([status, endsAt])
  @@map("subscriptions")
}

// Refresh tokens stored server-side (hashed) so they can be revoked.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Generic, reusable audit trail (LOCKED decision #2 - foundation
// infrastructure, not a future module). Business modules call
// src/lib/audit.ts's recordAuditEvent() rather than writing here
// directly, so metadata sanitization (see decision below) is never
// bypassed.
//
// Every field that references another record is nullable and uses
// onDelete: SetNull - an audit row must never disappear just because
// the thing it references was later deleted, and it must never block
// deletion of that thing either.
//
// NEVER store passwords, raw access tokens, raw refresh tokens, or any
// other secret in `metadata`. recordAuditEvent() strips known secret-
// shaped keys defensively, but callers are still responsible for not
// passing secrets in.
model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // e.g. "user.login", "user.logout". Business-domain modules will add
  // their own action names (e.g. "order.created") when they're built -
  // this table doesn't need to change for that.
  action String

  // e.g. "User", "Order". Kept as a free-form string (not an enum) so
  // future modules don't require a migration just to add an entity type.
  entityType String
  entityId   String?

  metadata      Json?
  correlationId String?

  @@index([businessId])
  @@index([branchId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// CUSTOMERS MODULE (first business module - see docs/CUSTOMERS.md)
// ---------------------------------------------------------------------
// DECISION (documented in full in docs/CUSTOMERS.md section F): a
// Customer belongs to a Business, NOT to a Branch. A customer who is
// served at multiple branches within the same business is still one
// Customer row - branch-specific activity (which branch handled a given
// order) belongs on Order once that module exists, not on Customer.
// This was chosen over per-branch Customer records because duplicating
// a customer per branch they visit would fragment their history and
// contact info across rows for no benefit at this stage; nothing in the
// approved requirements calls for branch-exclusive customer lists.
enum CustomerLifecycleStatus {
  ACTIVE
  DORMANT
  BLOCKED
  BLACKLISTED
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation("BusinessCustomers", fields: [businessId], references: [id], onDelete: Cascade)

  name  String
  // Stored normalized (digits only, optional leading "+") - see
  // src/modules/customers/customers.service.ts normalizePhone(). The
  // normalized form is what duplicate detection and search compare
  // against.
  phone String

  email   String?
  address String?
  notes   String?

  // Explicit business-initiated WhatsApp consent. Existing customers remain opted out.
  whatsappOptIn       Boolean   @default(false)
  whatsappOptInAt     DateTime?
  whatsappOptInSource String?
  whatsappOptOutAt    DateTime?

  // Persistent customer-specific instructions/preferences.
  // Examples: "Always fold his items" or "Do not give him items on credit".
  customerInstructions String?

  // Legacy compatibility flag. ACTIVE keeps this true; all other
  // lifecycle states keep it false until the legacy field is removed.
  isActive Boolean @default(true)

  lifecycleStatus   CustomerLifecycleStatus @default(ACTIVE)
  statusReason      String?
  statusChangedAt   DateTime?
  statusChangedById String?
  statusChangedBy   User?                   @relation("CustomerStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  statusHistory CustomerStatusHistory[]
  account       CustomerAccount?
  servicePrices CustomerServicePrice[]
  announcementRecipients AnnouncementRecipient[]
  communicationDeliveries CommunicationDelivery[]
  statusNotificationDeliveries OrderStatusNotificationDelivery[]
  customerGroups CustomerGroupMember[]
  automaticDiscounts PriceAdjustment[] @relation("CustomerAutomaticDiscounts")

  // Duplicate handling is soft (detection + explicit override), not a
  // hard DB-level unique constraint - see docs/CUSTOMERS.md section E.
  // A hard @@unique([businessId, phone]) would incorrectly block a
  // second legitimate customer at the same household/shared phone
  // number. A plain (non-unique) index still makes the duplicate-check
  // query and phone search efficient.
  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, name])
  @@map("customers")
}

model CustomerStatusHistory {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation("BusinessCustomerStatusHistory", fields: [businessId], references: [id], onDelete: Cascade)

  previousStatus CustomerLifecycleStatus?
  newStatus      CustomerLifecycleStatus
  reason         String
  changedAt      DateTime                 @default(now())
  changedById    String?
  changedBy      User?                    @relation("CustomerStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([customerId, changedAt])
  @@index([businessId, changedAt])
  @@map("customer_status_history")
}

// ---------------------------------------------------------------------
// SERVICES / PRICE LIST MODULE
// ---------------------------------------------------------------------
// Each service is a chargeable laundry item.
//
// `pieces` = physical pieces represented by one unit.
// `unitPrice` = price for one unit.
//
// Example:
// Complete Agbada = 3 pieces, ₦4,500 per unit.
//
// Therefore:
// QTY 2 × Complete Agbada
// PCS = 2 × 3 = 6
// Total Price = 2 × ₦4,500 = ₦9,000
//
// Prices are later snapshotted onto orders/invoices so changing the
// price list will never change historical transactions.
model Service {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  pieces    Int
  unitPrice Int
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  customerPrices CustomerServicePrice[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, name])
  @@map("services")
}

// ---------------------------------------------------------------------
// ORDERS MODULE
// ---------------------------------------------------------------------
// Orders are tenant-scoped by business and operationally scoped by branch.
//
// OrderItem stores a complete historical snapshot of the Service at the
// moment the order is created. Changing the current price list later can
// therefore never change an existing order.
//
// Receipt visibility:
//   garmentNote = customer-visible
//   internalNote = company/staff-only
enum OrderStatus {
  RECEIVED
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

model Color {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@map("colors")
}

model OrderNumberSequence {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("order_number_sequences")
}

model Order {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  orderNumber String

  status OrderStatus @default(RECEIVED)

  orderTotal Int @default(0)

  expectedReadyAt DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  // Visible to the customer.
  garmentNote String?

  // PRIVATE. Never expose this on customer-facing receipts.
  internalNote String?

  items    OrderItem[]
  garments Garment[]
  invoice  Invoice?
  statusNotificationDeliveries OrderStatusNotificationDelivery[]
  communicationDeliveries CommunicationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, orderNumber])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, branchId, createdAt])
  @@index([businessId, customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  garments Garment[]

  // Historical snapshot from Service at order creation.
  serviceName   String
  colors        String[] @default([])
  piecesPerUnit Int
  quantity      Int
  totalPieces   Int
  unitPrice     Int
  lineTotal     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([serviceId])
  @@map("order_items")
}

// ---------------------------------------------------------------------
// ACCOUNTING / EXPENSES MODULE
// ---------------------------------------------------------------------

// Expense lifecycle.
// Only APPROVED expenses with a non-null recognizedAt are included
// in the profit/loss calculation.
enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  VOID
}

// High-level classification used by the monthly financial statement.
// Loan principal and IOU movements deliberately do not use this model
// merely because cash moved.
enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  INVENTORY
  TRANSPORT
  MAINTENANCE
  FINANCE_CHARGE
  TAX
  EMPLOYEE_REIMBURSEMENT
  MISCELLANEOUS
  OTHER
}

enum FinancialStatementChannel {
  EMAIL
  WHATSAPP
}

enum FinancialStatementDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------
// INVOICES / RECEIPTS MODULE
// ---------------------------------------------------------------------

enum InvoiceStatus {
  ISSUED
  VOID
}

model Invoice {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // One invoice belongs to exactly one order.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Uses the same progressive 5-digit number as the order.
  invoiceNumber String

  status InvoiceStatus @default(ISSUED)

  // Historical customer identity snapshot.
  // Deliberately excludes phone, email and address because
  // customer contact information is NOT printed on either receipt.
  customerName String

  // Historical company snapshot for printed receipts.
  companyName    String
  companyPhone   String?
  companyEmail   String?
  companyWebsite String?
  companyAddress String?

  // Historical receipt branding snapshot.
  // Preserves the visual identity used when the invoice was created.
  logoUrl                String?
  receiptPrimaryColor    String?
  receiptAccentColor     String?
  receiptBackgroundColor String?
  receiptTextColor       String?
  receiptHeaderStyle     String?

  // Historical transaction totals.
  totalAmount Int

  // Customer-visible order note.
  garmentNote String?

  // PRIVATE. Never expose on the customer receipt.
  internalNote String?

  // Agreement printed on the customer copy.
  customerAgreement String

  subtotal                    Int      @default(0)
  adjustedSubtotal             Int      @default(0)
  adjustmentTotal              Int      @default(0)
  additiveTaxTotal             Int      @default(0)
  withholdingTaxTotal          Int      @default(0)
  appliedAdjustments           Json     @default("[]")
  appliedTaxes                 Json     @default("[]")

  items                       InvoiceItem[]
  payments                    Payment[]
  customerAccountTransactions CustomerAccountTransaction[] @relation("CustomerAccountTransactionInvoice")
  history                     InvoiceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@index([businessId, orderId])
  @@map("invoices")
}

model InvoiceHistory {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  businessId String
  branchId   String

  // EDITED, TRANSFERRED, VOIDED, DELETED
  action String

  // Sequential version of the saved historical state.
  version Int

  // Mandatory explanation supplied by the actor.
  reason String

  // Actor is intentionally stored as an ID rather than a destructive
  // relation so historical records survive user deactivation/deletion.
  actorUserId String

  // Complete invoice state before the correction.
  snapshot Json

  // Historical records must remain available for at least 60 days.
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([businessId, expiresAt])
  @@index([businessId, branchId, createdAt])
  @@map("invoice_history")
}

model InvoiceItem {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Historical snapshots from OrderItem.
  itemName      String
  colors        String[] @default([])
  piecesPerUnit Int
  quantity      Int
  totalPieces   Int
  unitPrice     Int
  totalPrice    Int

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------
// CUSTOMER ACCOUNT / WALLET MODULE
// ---------------------------------------------------------------------
//
// Customer accounts are business-wide. A customer therefore has one
// account across the organisation rather than a separate wallet per
// branch.
//
// CustomerAccountTransaction is an append-only financial ledger entry.
// The account balance will be calculated from these entries rather than
// stored as a mutable balance field.
//
// CREDIT      = money placed on the customer's account (POA)
// DEBIT       = money consumed from the customer's account
// ADJUSTMENT  = explicitly authorised correction
//
// Each transaction records the branch where the operation occurred.

enum CustomerAccountTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

model CustomerAccount {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  transactions CustomerAccountTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@map("customer_accounts")
}

model CustomerAccountTransaction {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  type CustomerAccountTransactionType

  // Always stored as a positive whole-naira amount.
  // Direction is represented by type.
  amount Int

  // Optional invoice association for account-funded payments.
  invoiceId String?
  invoice   Invoice? @relation("CustomerAccountTransactionInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)

  // Set when this ledger transaction creates a Pay from Account payment.
  payment Payment? @relation("PaymentCustomerAccountTransaction")

  // Optional link to an earlier ledger transaction for an authorised
  // adjustment/reversal. The original transaction remains immutable.
  referenceTransactionId String?
  referenceTransaction   CustomerAccountTransaction?  @relation("CustomerAccountTransactionReference", fields: [referenceTransactionId], references: [id], onDelete: Restrict)
  referencedBy           CustomerAccountTransaction[] @relation("CustomerAccountTransactionReference")

  note String?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, customerAccountId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([invoiceId])
  @@index([referenceTransactionId])
  @@map("customer_account_transactions")
}

// ---------------------------------------------------------------------
// PAYMENTS MODULE
// ---------------------------------------------------------------------

// Payment method used for an actual payment transaction.
// PARTIAL/PART PAYMENT is deliberately not a method: it is determined
// by comparing the amount paid against the invoice balance.
enum PaymentMethod {
  CASH
  TRANSFER
  POS
  PAY_FROM_ACCOUNT
}

// A recorded payment can be voided without deleting its historical record.
enum PaymentStatus {
  POSTED
  VOID
}

// Identifies whether a ledger row represents money received or returned.
enum PaymentType {
  PAYMENT
  REFUND
}

model Payment {
  id String @id @default(uuid())

  // Tenant and operational scope.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Every payment belongs to exactly one invoice.
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // Amount is stored as a whole-naira integer, consistent with
  // Invoice.totalAmount and Order.orderTotal.
  amount Int

  method PaymentMethod
  type   PaymentType   @default(PAYMENT)
  status PaymentStatus @default(POSTED)

  // For REFUND rows, links back to the original customer payment.
  // Original PAYMENT rows remain unchanged and preserve their history.
  refundOfPaymentId String?
  refundOfPayment   Payment?  @relation("PaymentRefund", fields: [refundOfPaymentId], references: [id], onDelete: Restrict)
  refunds           Payment[] @relation("PaymentRefund")

  // Optional transaction/reference number supplied for transfer or POS.
  reference String?

  // Optional internal note about the payment.
  note String?

  // Present when this payment was funded from the customer's account.
  customerAccountTransactionId String?                     @unique
  customerAccountTransaction   CustomerAccountTransaction? @relation("PaymentCustomerAccountTransaction", fields: [customerAccountTransactionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@index([businessId, invoiceId, createdAt])
  @@index([invoiceId])
  @@index([refundOfPaymentId])
  @@map("payments")
}

// ---------------------------------------------------------------------
// GARMENTS MODULE
// ---------------------------------------------------------------------
// A Garment represents one physical garment/piece received for an order.
// It is always tenant-scoped by business and operationally scoped by
// branch. Each garment belongs to an OrderItem and therefore retains the
// historical service snapshot through that OrderItem.
//
// Garment status tracks the physical processing lifecycle independently
// from the overall Order status.

enum GarmentStatus {
  RECEIVED
  PROCESSING
  READY
  PICKED_UP
  DAMAGED
  LOST
}

model Garment {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  garmentNumber Int
  status        GarmentStatus @default(RECEIVED)

  note String?

  receivedAt DateTime  @default(now())
  readyAt    DateTime?
  pickedUpAt DateTime?
  damagedAt  DateTime?
  lostAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderItemId, garmentNumber])
  @@index([businessId, branchId, createdAt])
  @@index([businessId, orderId])
  @@index([businessId, status])
  @@index([orderItemId])
  @@map("garments")
}

// ---------------------------------------------------------------------
// DATA MIGRATION INFRASTRUCTURE
// ---------------------------------------------------------------------
// Migration jobs are tenant-scoped. Raw source files are stored outside
// PostgreSQL through the storage abstraction; the database stores only
// metadata, status, summaries and issues. This keeps large customer
// backups out of the relational database while preserving a durable,
// auditable migration workflow.
enum MigrationJobStatus {
  ANALYZING
  READY
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum MigrationSourceType {
  LAUNDRY_BACKUP
  DBF
  CSV
  JSON
  XLSX
  UNKNOWN
}

enum MigrationIssueSeverity {
  INFO
  WARNING
  ERROR
}

model MigrationJob {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sourceType   MigrationSourceType
  sourceName   String
  status       MigrationJobStatus  @default(ANALYZING)
  sourcePath   String
  sourceSha256 String
  summary      Json?
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  completedAt  DateTime?

  files  MigrationFile[]
  issues MigrationIssue[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@map("migration_jobs")
}

model MigrationFile {
  id           String       @id @default(uuid())
  jobId        String
  job          MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  relativePath String
  format       String
  tableName    String?
  sizeBytes    Int
  sha256       String
  rowCount     Int?
  headers      Json?
  status       String       @default("detected")
  errorMessage String?
  createdAt    DateTime     @default(now())

  @@unique([jobId, relativePath])
  @@index([jobId, format])
  @@map("migration_files")
}

model MigrationIssue {
  id         String                 @id @default(uuid())
  jobId      String
  job        MigrationJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  severity   MigrationIssueSeverity
  code       String
  message    String
  entityType String?
  sourceFile String?
  sourceRow  Int?
  details    Json?
  resolvedAt DateTime?
  createdAt  DateTime               @default(now())

  @@index([jobId, severity])
  @@map("migration_issues")
}

// ---------------------------------------------------------------------
// INVENTORY MODULE
// ---------------------------------------------------------------------
// Inventory items are business-owned catalog records. Actual quantities
// are maintained separately per branch through InventoryStock.
//
// InventoryMovement provides the historical stock ledger. InventoryStock
// stores the current operational balance for fast reads and reconciliation.

enum InventoryUnit {
  PIECE
  PACK
  BOTTLE
  LITRE
  KILOGRAM
  BOX
  ROLL
  OTHER
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  RETURN
  WASTE
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
  STOCKTAKE
}

enum InventoryTransferStatus {
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryStocktakeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  APPLIED
  CANCELLED
}

model InventoryItem {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  sku         String?
  category    String?
  storageLocation String?
  description String?
  unit        InventoryUnit

  // Reorder quantity is the suggested quantity to purchase when stock is low.
  reorderQuantity Int @default(0)

  // A stock level at or below this value is considered low stock.
  lowStockThreshold Int @default(0)

  isActive Boolean @default(true)

  stocks    InventoryStock[]
  movements InventoryMovement[]
  purchaseOrderLines InventoryPurchaseOrderLine[]
  goodsReceiptLines InventoryGoodsReceiptLine[]
  transferLines InventoryTransferLine[]
  stocktakeLines InventoryStocktakeLine[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@unique([businessId, sku])
  @@index([businessId, category])
  @@index([businessId, isActive])
  @@index([businessId, name])
  @@map("inventory_items")
}

model InventoryStock {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  // Current physical quantity held by this branch.
  quantity Int @default(0)
  reservedQuantity Int @default(0)
  averageUnitCost Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One current stock balance per inventory item per branch.
  @@unique([inventoryItemId, branchId])
  @@index([businessId, branchId])
  @@index([businessId, branchId, quantity])
  @@index([businessId, inventoryItemId])
  @@map("inventory_stocks")
}

model InventoryMovement {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  // RECEIPT and ISSUE use positive quantities.
  // The movement type determines whether stock increases or decreases.
  // ADJUSTMENT may represent either an increase or decrease.
  quantity Int

  type InventoryMovementType
  unitCost Int @default(0)

  // Stock balance immediately after this movement.
  resultingQuantity Int

  reason    String?
  reference String?

  // User responsible for creating the movement.
  createdById String
  createdBy   User   @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Movement rows are historical records and are not deleted by normal
  // inventory operations.
  createdAt DateTime @default(now())

  @@index([businessId, branchId, createdAt])
  @@index([businessId, branchId, inventoryItemId, createdAt])
  @@index([businessId, inventoryItemId, createdAt])
  @@index([createdById])
  @@map("inventory_movements")
}

enum InventoryPurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model InventoryTransfer {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceBranchId String
  sourceBranch Branch @relation("InventoryTransferSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranchId String
  destinationBranch Branch @relation("InventoryTransferDestination", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  transferNumber String
  status InventoryTransferStatus @default(DISPATCHED)
  notes String?
  createdById String
  createdBy User @relation("InventoryTransferCreator", fields: [createdById], references: [id], onDelete: Restrict)
  dispatchedById String
  dispatchedBy User @relation("InventoryTransferDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict)
  receivedById String?
  receivedBy User? @relation("InventoryTransferReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  dispatchedAt DateTime @default(now())
  receivedAt DateTime?
  lines InventoryTransferLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([businessId, transferNumber])
  @@index([businessId, sourceBranchId, status, createdAt])
  @@index([businessId, destinationBranchId, status, createdAt])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id String @id @default(uuid())
  transferId String
  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantityDispatched Int
  quantityReceived Int @default(0)
  unitCost Int @default(0)
  createdAt DateTime @default(now())
  @@unique([transferId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("inventory_transfer_lines")
}

model InventoryStocktake {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reference String
  status InventoryStocktakeStatus @default(DRAFT)
  notes String?
  createdById String
  createdBy User @relation("InventoryStocktakeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedById String?
  submittedBy User? @relation("InventoryStocktakeSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt DateTime?
  approvedById String?
  approvedBy User? @relation("InventoryStocktakeApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt DateTime?
  appliedById String?
  appliedBy User? @relation("InventoryStocktakeApplier", fields: [appliedById], references: [id], onDelete: Restrict)
  appliedAt DateTime?
  lines InventoryStocktakeLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([businessId, reference])
  @@index([businessId, branchId, status, createdAt])
  @@map("inventory_stocktakes")
}

model InventoryStocktakeLine {
  id String @id @default(uuid())
  stocktakeId String
  stocktake InventoryStocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  expectedQuantity Int
  countedQuantity Int
  variance Int
  createdAt DateTime @default(now())
  @@unique([stocktakeId, inventoryItemId])
  @@map("inventory_stocktake_lines")
}

model InventoryReservation {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity Int
  reference String?
  status String @default("ACTIVE")
  createdById String
  createdBy User @relation("InventoryReservationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt DateTime?
  releasedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([businessId, branchId, status, expiresAt])
  @@index([inventoryItemId, branchId, status])
  @@map("inventory_reservations")
}


model InventorySupplier {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  contactName String?
  email String?
  phone String?
  address String?
  taxId String?
  notes String?
  isActive Boolean @default(true)
  purchaseOrders InventoryPurchaseOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@map("inventory_suppliers")
}

model InventoryPurchaseOrder {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId String
  supplier InventorySupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderNumber String
  status InventoryPurchaseOrderStatus @default(DRAFT)
  orderedAt DateTime?
  expectedAt DateTime?
  notes String?
  createdById String
  createdBy User @relation("InventoryPurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines InventoryPurchaseOrderLine[]
  receipts InventoryGoodsReceipt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([businessId, orderNumber])
  @@index([businessId, branchId, status, createdAt])
  @@index([businessId, supplierId, createdAt])
  @@map("inventory_purchase_orders")
}

model InventoryPurchaseOrderLine {
  id String @id @default(uuid())
  purchaseOrderId String
  purchaseOrder InventoryPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantityOrdered Int
  quantityReceived Int @default(0)
  unitCost Int
  createdAt DateTime @default(now())
  goodsReceiptLines InventoryGoodsReceiptLine[]
  @@unique([purchaseOrderId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("inventory_purchase_order_lines")
}

model InventoryGoodsReceipt {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseOrderId String
  purchaseOrder InventoryPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receiptNumber String
  receivedById String
  receivedBy User @relation("InventoryGoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt DateTime @default(now())
  notes String?
  lines InventoryGoodsReceiptLine[]
  createdAt DateTime @default(now())
  @@unique([businessId, receiptNumber])
  @@index([businessId, branchId, receivedAt])
  @@index([purchaseOrderId, receivedAt])
  @@map("inventory_goods_receipts")
}

model InventoryGoodsReceiptLine {
  id String @id @default(uuid())
  goodsReceiptId String
  goodsReceipt InventoryGoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine InventoryPurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity Int
  unitCost Int
  createdAt DateTime @default(now())
  @@index([inventoryItemId, createdAt])
  @@map("inventory_goods_receipt_lines")
}

// ---------------------------------------------------------------------
// PAYROLL / STAFF FINANCE MODULE
// ---------------------------------------------------------------------
//
// Payroll is an internal business-finance system. It is separate from
// customer invoices/payments.
//
// IOUs and loans can be approved against an employee and subsequently
// deducted through payroll. PayrollDeduction preserves the exact
// historical amount deducted and the source obligation.
// ---------------------------------------------------------------------

enum PayrollPeriodStatus {
  OPEN
  PROCESSING
  FINALIZED
  PAID
  VOID
}

enum PayrollApprovalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  DECLINED
}

enum IOUStatus {
  PENDING
  APPROVED
  PARTIALLY_DEDUCTED
  FULLY_DEDUCTED
  REJECTED
  CANCELLED
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  PARTIALLY_REPAID
  FULLY_REPAID
  REJECTED
  CANCELLED
}

enum PayrollDeductionType {
  IOU
  LOAN
  OTHER
}

// Method used to disburse an employee's payroll.
enum PayrollPaymentMethod {
  CASH
  TRANSFER
  POS
}

// Payroll payments are historical records.
// Voiding changes the status instead of deleting the record.
enum PayrollPaymentStatus {
  POSTED
  VOID
}

// Explicit accounting expense record.
//
// This is intentionally separate from payments, loans, IOUs and payroll
// disbursements. A cash movement is not automatically a P&L expense.
//
// P&L inclusion rule:
//   status = APPROVED
//   AND recognizedAt IS NOT NULL
//   AND recognizedAt falls within the statement period.
//
// This prevents loan principal, IOU advances/recoveries and payroll
// disbursements from being double-counted as ordinary expenses.
model Expense {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  category ExpenseCategory
  status   ExpenseStatus   @default(PENDING)

  description String
  amount      Int

  // Date the underlying expense was incurred.
  incurredAt DateTime

  // Accounting recognition date.
  // Only recognized expenses enter P&L calculations.
  recognizedAt DateTime?

  recognizedById String?
  recognizedBy   User?   @relation("ExpenseRecognizer", fields: [recognizedById], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  // Optional reference for receipts, supplier references, bank records,
  // invoice numbers or other supporting documentation.
  reference String?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, branchId, incurredAt])
  @@index([businessId, branchId, status])
  @@index([businessId, recognizedAt])
  @@index([businessId, category, recognizedAt])
  @@index([createdById])
  @@index([approvedById])
  @@index([recognizedById])
  @@map("expenses")
}

model EmployeeCompensation {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Historical basic salary in whole naira.
  basicSalary Int

  // The salary becomes effective on this date.
  effectiveFrom DateTime

  // Null means this is the current compensation record.
  effectiveTo DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, employeeId, effectiveFrom])
  @@index([businessId, employeeId, effectiveTo])
  @@map("employee_compensations")
}

model PayrollPeriod {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

