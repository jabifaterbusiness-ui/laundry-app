# Copy to .env and fill in for your local machine.
# NEVER commit a real .env file. NEVER put production credentials here.

# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# --- Database (local dev only - matches docker-compose.yml defaults) ---
DATABASE_URL="postgresql://laundry_dev:laundry_dev_local_only@localhost:5432/laundry_dev?schema=public"

# --- Auth ---
# Generate real values locally, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_LOCAL_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LOCAL_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Digital receipt delivery ---
# Resend API key for customer digital receipt emails.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# Verified sender address/domain configured in Resend.
RECEIPT_EMAIL_FROM=receipts@example.com
# Meta WhatsApp Cloud API version.
WHATSAPP_API_VERSION=v23.0
# Meta WhatsApp Business phone number ID.
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
# Meta WhatsApp Cloud API access token.
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_ACCESS_TOKEN

# --- Logging ---
LOG_LEVEL=info

# Data migration / backup storage
MIGRATION_STORAGE_DIR=./data/migrations
MIGRATION_STORAGE_KEY=replace-with-a-random-secret-at-least-16-characters

# Dedicated 32-byte key for automatic cloud backup encryption (64 hex characters).
# Generate with: openssl rand -hex 32
# Required before enabling automatic backups; do not reuse MIGRATION_STORAGE_KEY.
# BACKUP_ENCRYPTION_KEY=
MIGRATION_MAX_UPLOAD_BYTES=262144000
MIGRATION_MAX_UNCOMPRESSED_BYTES=524288000
